# ==========================================
# PesaPay Environment Configuration Template
# Copy this file to .env and adjust variables
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Database Configuration
# For quick zero-dependency local dev: file:./dev.db
# For production PostgreSQL: postgresql://postgres:password@localhost:5432/pesapay?schema=public
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_ACCESS_SECRET=pesapay_dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=pesapay_dev_refresh_secret_change_in_production_min_32_chars
API_KEY_SECRET=pesapay_mobile_client_secret_token

# Payment Provider: 'mock' (default for development/tests) or 'daraja' (Safaricom M-Pesa)
PAYMENT_PROVIDER=mock

# Safaricom Daraja API Configuration (Required when PAYMENT_PROVIDER=daraja)
MPESA_ENVIRONMENT=sandbox
# Sandbox endpoints: https://sandbox.safaricom.co.ke
# Production endpoints: https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
# Business shortcode (e.g. 174379 for standard Daraja Sandbox STK Push, or Till Number/Store Number)
MPESA_SHORTCODE=174379
# Passkey from Daraja Portal (for Lipa na M-Pesa Online)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS callback URL (Use ngrok or Cloudflare tunnel for local testing)
# Example: https://your-subdomain.ngrok-free.app/api/v1/payments/mpesa/callback
MPESA_CALLBACK_URL=https://pesapay-api.example.com/api/v1/payments/mpesa/callback

# Mobile Frontend Configuration
# When testing on physical Android device over Wi-Fi, change to your LAN IP e.g. http://192.168.1.100:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_NAME=PesaPay
